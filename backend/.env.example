# InfoScout AI 后端配置
# 复制此文件为 .env 并填入你的 API Key

# ===== 调研引擎 =====
# 报告保存目录
LAST30DAYS_MEMORY_DIR=./results
# CLI 引擎（last30days）单次调研超时（秒），默认 600
RESEARCH_TIMEOUT_SECONDS=600

# ===== LLM（LangChain Agent 调用）=====
# OpenAI（用于 Agent 推理与 Embedding）。留空则 Agent 降级为直接调研模式
OPENAI_API_KEY=
# 如用兼容接口（如 DeepSeek、千问），填 base_url
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ===== 多模型分工（多 Agent 图编排）=====
# 检索/清洗 Agent 的 fast 档：填了 DeepSeek Key 则走 DeepSeek 控成本，
# 留空则回落到上面的 OpenAI 配置（FAST_LLM_MODEL 指定回落时用的模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
FAST_LLM_MODEL=gpt-4o-mini

# ===== Milvus 向量库（RAG）=====
# 留空使用默认；设 MILVUS_ENABLED=false 则跳过 Milvus，RAG 降级
MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=research_results

# ===== BGE-Reranker（召回后重排，可选）=====
# 本地 Cross-Encoder，需要 pip install FlagEmbedding（含 torch，体积较大）。
# 未安装或未配置时自动降级为纯向量相似度检索，不影响调研主链路。
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BGE_RERANKER_TOP_K=3

# ===== MCP（多源 Tools 对外暴露，可选）=====
# python -m app.mcp_server 以 stdio 方式启动，向 Claude Desktop 等暴露
# search_reddit / search_youtube / search_juejin / search_web 四个工具。
MCP_SERVER_ENABLED=true

# ===== 可选数据源（last30days 引擎用）=====
# Brave Search（免费 2000 次/月）：https://brave.com/search/api/
BRAVE_API_KEY=
XAI_API_KEY=
BSKY_HANDLE=
BSKY_APP_PASSWORD=
PERPLEXITY_API_KEY=
